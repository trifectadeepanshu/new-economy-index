DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_READ_URL=postgresql://reader:password@host-pooler/dbname?sslmode=require
DATABASE_WRITE_URL=postgresql://writer:password@host-pooler/dbname?sslmode=require
DATABASE_MIGRATION_URL=postgresql://owner:password@host/dbname?sslmode=require
CRON_SECRET=your-secret-here
ADMIN_SECRET=your-separate-admin-secret-here
